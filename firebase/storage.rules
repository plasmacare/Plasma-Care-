rules_version = '2';

// See firestore.rules for the auth model — same reasoning applies here.
// Deploy with: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    match /report-templates/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /generated-reports/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
