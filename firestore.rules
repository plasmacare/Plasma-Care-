rules_version = '2';

// This project uses Firebase only for the pixel-perfect report format
// library (report_templates). Everything else in the app is on Supabase.
// The app signs in anonymously to Firebase purely to satisfy `request.auth
// != null` here — real access control (who is staff/admin) is enforced by
// Supabase auth + role checks before this code path is ever reached from
// the UI. Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /report_templates/{templateId} {
      allow read, write: if request.auth != null;
    }
  }
}
